{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["index.html", "src/**/*.handler.ts"],
  "project": ["src/**/*.{ts,tsx,css}"],
  "ignoreExportsUsedInFile": true,
  "paths": {
    "@/*": ["src/*"]
  },
  "ignoreIssues": {
    "src/common/components/**": ["exports", "types", "nsExports", "nsTypes", "enumMembers"],
    "**/*.d.ts": ["files"]
  }
}
